{
  "manifest_version": 3,
  "name": "MY Simulator – Mobile & Responsive Website Tester",
  "short_name": "MY Simulator",
  "version": "1.0.0",
  "author": "MY Simulator",
  "minimum_chrome_version": "116",
  "description": "Test responsive websites on iPhone, Android, iPad, laptop & TV frames side by side. Rotate, screenshot & sync scroll.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "MY Simulator — test on iPhone, Android & more (Alt+Shift+M)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+M" },
      "description": "Open / close MY Simulator"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/frame-ua.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/frame-agent.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
